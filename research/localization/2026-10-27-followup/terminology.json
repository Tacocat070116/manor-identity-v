  "fieldEdits": [
    {
      "path": "data/characters/44/tips/1",
      "after": "재정비 추적 · 따뜻한 비가 만드는 구름은 벽 너머에서도 표시됩니다. 기상학자의 자원 변화가 보이면 주변에 생긴 구름도 확인해, 팀원이 재정비하는 위치를 찾는 단서로 활용합니다.",
      "sources": [
        "W-C45"
      ],
      "reason": "이동 기술 층운과 따뜻한 비의 구름을 구분한다. 기존 효과 설명의 밸런스 조건은 변경하지 않는다."
    },
    {
      "path": "data/characters/44/use",
      "after": "감시자가 본체나 동료에게 붙으려는 순간에는 빠져나갈 방향의 반대로 밀어냅니다. 지형을 넘어야 할 때는 층운을, 안전하게 회복할 여유가 생겼을 때는 따뜻한 비를 선택합니다.",
      "sources": [
        "W-C45"
      ],
      "reason": "본문에서 도입한 기술 명칭으로 선택지를 구분한다."
    },
    {
      "path": "data/characters/49/skill",
      "after": "맹인용 지팡이로 감시자의 위치를 확인하고 팀원에게 공유합니다. 걷다가 달리기로 전환할 때 얻는 가속과 행동 속도 보너스로 위험한 구역을 벗어납니다.",
      "sources": [
        "K20210805"
      ],
      "reason": "공식 한국어 공지의 소지품 이름을 설명 첫머리에 명시한다."
    },
    {
      "path": "data/characters/50/skill",
      "after": "걸리버 여행기를 읽어 몸을 작게 만들고 감시자와의 거리를 확인합니다. 보물에서 모은 암호 페이지를 필요한 암호 장치에 사용해 해독을 진행합니다.",
      "sources": [
        "K20210826",
        "K20210916"
      ],
      "reason": "공식 소지품 이름과 결과물을 구분한다."
    },
    {
      "path": "data/characters/62/skill",
      "after": "추억 조각으로 주변 캐릭터를 밀어냅니다. 기억 동기화를 사용하면 동료의 이동과 판자·창틀 이용, 구출을 도울 수 있습니다.",
      "sources": [
        "K20220616",
        "W-C63"
      ],
      "reason": "기억 동기화의 전체 이름을 쓰고 조사를 정리한다."
    },
    {
      "path": "data/characters/73/skill",
      "after": "감시자 근처에서 원숭이 조각상에 저주를 모아 기절시킵니다. 저주를 적게 쓰는 짧은 기절과 여러 겹을 소모하는 긴 기절을 상황에 맞게 선택합니다.",
      "sources": [
        "K20220512"
      ],
      "reason": "소지품 이름을 설명 첫머리에 명시하며 충전과 사용 조건은 기존 설명을 유지한다."
    },
    {
      "path": "data/matchups/313/condition",
      "after": "자동으로 발동하는 비늘 표피는 첫 소수점 피해를 막을 수 있으므로 잔여 방어를 확인합니다.",
      "sources": [
        "K20220616"
      ],
      "reason": "자동 방어와 직접 사용하는 비늘 경화를 구분하며 기존 상호작용 설명을 보존한다."
    },
    {
      "path": "introductions/characters/c33",
      "after": "렌즈를 이용해 떨어진 구역을 공격하고 해당 구역으로 이동합니다. 원거리 견제와 추격을 연결하는 감시자입니다.",
      "sources": [
        "F024"
      ],
      "reason": "공식 한국어 소개의 렌즈 표현을 사용한다. 소개문 렌즈와 간접 확인된 스킬 제목 구강경을 임의로 같은 명칭으로 치환하지 않는다."
    },
    {
      "path": "data/characters/66/skill",
      "after": "진정제로 소수점 피해까지 치료할 수 있고, 자가 치료 진행도가 유지되어 짧은 틈에도 회복을 이어 갈 수 있습니다. 약물 증강제를 사용하면 치료 진행도를 즉시 높입니다.",
      "sources": [
        "K20210916",
        "W-C67"
      ],
      "reason": "진정제 소지품 이름을 소개한다. 약물 증강제는 이전의 간접 확인 수준과 효과를 유지한다."
    },
    {
      "path": "data/characters/62/caution",
      "after": "밀치기는 동료에게도 적용돼 준비한 판자나 창틀에서 벗어나게 할 수 있습니다. 기억 동기화 상태로 함께 해독하는 효율은 각자 해독할 때와 다르므로 지원을 끝낼 위치를 미리 정합니다.",
      "sources": [
        "K20220616"
      ],
      "reason": "기술 이름을 명시한 뒤 조사와 서술어를 자연스럽게 정리한다."
    },
    {
      "path": "data/characters/62/response",
      "after": "추억 조각에 밀릴 방향을 예상하며 위치를 잡습니다. 기억 동기화로 연결된 두 사람을 계속 쫓을지 다른 암호 장치를 견제할지 판단합니다.",
      "sources": [
        "K20220616"
      ],
      "reason": "기술 이름을 명시한 뒤 조사와 서술어를 자연스럽게 정리한다."
    },
    {
      "path": "data/matchups/182/summary",
      "after": "표식 없는 동료에게 기억 동기화를 사용하면 동료에게 새 표식을 쌓아야 합니다.",
      "sources": [
        "K20220616"
      ],
      "reason": "기술 이름을 명시한 뒤 조사와 서술어를 자연스럽게 정리한다."
    },
    {
      "path": "data/matchups/182/condition",
      "after": "동료가 이미 표식을 지녔거나 기억 동기화를 사용할 수 없는 상태라면 이점이 줄어듭니다.",
      "sources": [
